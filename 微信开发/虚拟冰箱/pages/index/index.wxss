.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.inventory-surface {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.door-scene {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 14rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.door-heading {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 8rpx 22rpx;
}

.door-copy {
  flex: 1;
  min-width: 0;
}

.door-title,
.door-subtitle {
  display: block;
}

.door-title {
  color: #173b2d;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.door-subtitle {
  margin-top: 8rpx;
  color: #52675e;
  font-size: 23rpx;
}

.direct-stock {
  flex: none;
  width: 144rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  color: #1f6046;
  background: #e2ebe3;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.fridge-door {
  position: relative;
  flex: 1;
  min-height: 620rpx;
  overflow: hidden;
  background: #d9e1da;
  border-radius: 32rpx;
  box-shadow: inset -18rpx 0 28rpx rgba(70, 95, 83, 0.08), 0 20rpx 48rpx rgba(44, 65, 56, 0.13);
  transform-origin: left center;
}

.door-scene.opening,
.inventory-surface.closing {
  will-change: transform, opacity;
}

.door-scene.opening {
  animation: door-open 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.inventory-surface.closing {
  animation: inventory-close 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
  pointer-events: none;
}

@keyframes door-open {
  from {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
  }
  to {
    transform: translate3d(-36rpx, 0, 0) scale(0.985);
    opacity: 0;
  }
}

@keyframes inventory-close {
  from {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
  }
  to {
    transform: translate3d(36rpx, 0, 0) scale(0.985);
    opacity: 0;
  }
}

.door-seam {
  position: absolute;
  top: 0;
  right: 78rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(71, 99, 86, 0.12);
}

.door-brand {
  position: absolute;
  z-index: 2;
  top: 26rpx;
  left: 28rpx;
  padding: 10rpx 16rpx;
  color: #52675e;
  background: rgba(255, 253, 247, 0.6);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.magnet-area {
  position: absolute;
  z-index: 3;
  top: 86rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  width: auto;
  height: auto;
}

.door-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420rpx;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
}

.empty-magnet-mark {
  position: relative;
  width: 96rpx;
  height: 82rpx;
  margin: 0 auto 24rpx;
  background: rgba(255, 253, 247, 0.68);
  border-radius: 10rpx;
  transform: rotate(-4deg);
  box-shadow: 0 10rpx 22rpx rgba(44, 65, 56, 0.08);
}

.empty-magnet-mark view {
  position: absolute;
  top: -12rpx;
  left: 38rpx;
  width: 22rpx;
  height: 22rpx;
  background: #f2b86b;
  border-radius: 50%;
}

.door-empty-title,
.door-empty-copy {
  display: block;
}

.door-empty-title {
  color: #496156;
  font-size: 29rpx;
  font-weight: 700;
}

.door-empty-copy {
  margin-top: 10rpx;
  color: #52675e;
  font-size: 23rpx;
  line-height: 1.55;
}

.magnet-item {
  position: absolute;
  box-sizing: border-box;
  transform-origin: center;
  transition: transform 120ms cubic-bezier(0.16, 1, 0.3, 1), filter 120ms ease-out;
  will-change: transform;
}

.magnet-item.dragging {
  transition: none;
  transform: scale(1.045);
  filter: drop-shadow(0 22rpx 24rpx rgba(24, 66, 49, 0.28));
}

.magnet-item.drag-blocked {
  filter: drop-shadow(0 18rpx 22rpx rgba(127, 65, 57, 0.38));
}

.magnet-note {
  width: 272rpx;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  padding: 34rpx 26rpx 20rpx;
  color: #4d422d;
  background: #f8e7ca;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 24rpx rgba(63, 72, 58, 0.16);
}

.note-pin {
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 26rpx;
  height: 26rpx;
  background: #f2b86b;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(91, 64, 30, 0.2);
  transform: translateX(-50%);
}

.note-content {
  flex: 1;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-all;
}

.magnet-edit-hint {
  display: block;
  margin-top: 8rpx;
  color: #625f5a;
  font-size: 19rpx;
  text-align: right;
}

.magnet-photo {
  display: block;
  width: 272rpx;
  height: 320rpx;
  padding: 14rpx 14rpx 40rpx;
  background: #fffdf7;
  border-radius: 10rpx;
  box-shadow: 0 14rpx 28rpx rgba(44, 65, 56, 0.18);
}

.magnet-album {
  display: block;
  width: 300rpx;
  height: 260rpx;
  padding: 14rpx 14rpx 64rpx;
  background: #fffdf7;
  border-radius: 12rpx;
  box-shadow: 0 16rpx 30rpx rgba(44, 65, 56, 0.2);
}

.album-stack {
  position: absolute;
  width: 278rpx;
  height: 206rpx;
  background: #e6d9c3;
  border: 8rpx solid #fffdf7;
  border-radius: 9rpx;
  box-sizing: border-box;
}

.album-stack-back {
  top: 4rpx;
  left: 12rpx;
  transform: rotate(-3deg);
}

.album-stack-middle {
  top: 6rpx;
  left: 10rpx;
  transform: rotate(2deg);
}

.album-cover {
  position: relative;
  width: 272rpx;
  height: 178rpx;
  display: block;
  border-radius: 6rpx;
}

.album-caption {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  padding-top: 10rpx;
}

.album-title {
  min-width: 0;
  overflow: hidden;
  color: #31483e;
  font-size: 22rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-count {
  flex: none;
  color: #708078;
  font-size: 17rpx;
}

.door-photo {
  width: 244rpx;
  height: 228rpx;
  display: block;
  background: #edf0eb;
  border-radius: 5rpx;
  pointer-events: none;
}

.note-content,
.magnet-edit-hint,
.album-cover,
.album-caption,
.sticker-art {
  pointer-events: none;
}

.photo-tape {
  position: absolute;
  z-index: 2;
  top: -10rpx;
  left: 78rpx;
  width: 108rpx;
  height: 28rpx;
  background: rgba(242, 184, 107, 0.78);
  transform: rotate(-3deg);
}

.photo-hint {
  margin-top: 8rpx;
  color: #667970;
}

.magnet-sticker {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sticker-art {
  position: relative;
  width: 124rpx;
  height: 124rpx;
}

.sticker-part {
  position: absolute;
  box-sizing: border-box;
}

.sticker-heart .sticker-part-a {
  top: 39rpx;
  left: 38rpx;
  width: 58rpx;
  height: 58rpx;
  background: #f2b86b;
  transform: rotate(45deg);
}

.sticker-heart .sticker-part-b,
.sticker-heart .sticker-part-c {
  top: 21rpx;
  width: 58rpx;
  height: 58rpx;
  background: #f2b86b;
  border-radius: 50%;
}

.sticker-heart .sticker-part-b {
  left: 20rpx;
}

.sticker-heart .sticker-part-c {
  left: 48rpx;
}

.sticker-leaf .sticker-part-a {
  top: 24rpx;
  left: 20rpx;
  width: 88rpx;
  height: 62rpx;
  background: #3e6e59;
  border-radius: 80rpx 8rpx 80rpx 8rpx;
  transform: rotate(-24deg);
}

.sticker-leaf .sticker-part-b {
  top: 68rpx;
  left: 54rpx;
  width: 62rpx;
  height: 5rpx;
  background: #fffdf7;
  border-radius: 999rpx;
  transform: rotate(-38deg);
}

.sticker-leaf .sticker-part-c {
  top: 78rpx;
  left: 60rpx;
  width: 44rpx;
  height: 6rpx;
  background: #3e6e59;
  border-radius: 999rpx;
  transform: rotate(52deg);
}

.sticker-sun .sticker-part-a {
  top: 27rpx;
  left: 27rpx;
  width: 70rpx;
  height: 70rpx;
  background: #f2b86b;
  border: 10rpx solid #fffdf7;
  border-radius: 50%;
}

.sticker-sun .sticker-part-b,
.sticker-sun .sticker-part-c {
  top: 58rpx;
  left: 6rpx;
  width: 112rpx;
  height: 8rpx;
  background: #f2b86b;
  border-radius: 999rpx;
}

.sticker-sun .sticker-part-c {
  transform: rotate(90deg);
}

.sticker-spark .sticker-part-a {
  top: 18rpx;
  left: 38rpx;
  width: 54rpx;
  height: 86rpx;
  background: #1f6046;
  transform: rotate(45deg) skew(-12deg, -12deg);
}

.sticker-spark .sticker-part-b,
.sticker-spark .sticker-part-c {
  width: 20rpx;
  height: 20rpx;
  background: #f2b86b;
  border-radius: 50%;
}

.sticker-flower .sticker-part-a,
.sticker-flower .sticker-part-b {
  top: 18rpx;
  left: 46rpx;
  width: 34rpx;
  height: 88rpx;
  background: #e99f93;
  border-radius: 50%;
}

.sticker-flower .sticker-part-b {
  transform: rotate(90deg);
}

.sticker-flower .sticker-part-c {
  top: 45rpx;
  left: 45rpx;
  width: 36rpx;
  height: 36rpx;
  background: #f2b86b;
  border: 6rpx solid #fffdf7;
  border-radius: 50%;
}

.sticker-cloud .sticker-part-a {
  top: 52rpx;
  left: 14rpx;
  width: 98rpx;
  height: 48rpx;
  background: #eef2ec;
  border: 5rpx solid #3e6e59;
  border-radius: 999rpx;
}

.sticker-cloud .sticker-part-b,
.sticker-cloud .sticker-part-c {
  background: #eef2ec;
  border: 5rpx solid #3e6e59;
  border-radius: 50%;
}

.sticker-cloud .sticker-part-b {
  top: 28rpx;
  left: 30rpx;
  width: 52rpx;
  height: 52rpx;
}

.sticker-cloud .sticker-part-c {
  top: 42rpx;
  right: 16rpx;
  width: 38rpx;
  height: 38rpx;
}

.sticker-berry .sticker-part-a,
.sticker-berry .sticker-part-b {
  width: 54rpx;
  height: 54rpx;
  background: #b55d63;
  border: 7rpx solid #fffdf7;
  border-radius: 50%;
}

.sticker-berry .sticker-part-a {
  top: 44rpx;
  left: 18rpx;
}

.sticker-berry .sticker-part-b {
  top: 54rpx;
  right: 18rpx;
}

.sticker-berry .sticker-part-c {
  top: 20rpx;
  left: 48rpx;
  width: 48rpx;
  height: 28rpx;
  background: #3e6e59;
  border-radius: 80rpx 8rpx 80rpx 8rpx;
  transform: rotate(-20deg);
}

.sticker-home .sticker-part-a {
  top: 50rpx;
  left: 28rpx;
  width: 72rpx;
  height: 58rpx;
  background: #f8e7ca;
  border: 6rpx solid #1f6046;
  border-radius: 6rpx;
}

.sticker-home .sticker-part-b {
  top: 18rpx;
  left: 34rpx;
  width: 62rpx;
  height: 62rpx;
  background: #e99f93;
  border: 6rpx solid #1f6046;
  transform: rotate(45deg);
}

.sticker-home .sticker-part-c {
  z-index: 2;
  bottom: 16rpx;
  left: 54rpx;
  width: 28rpx;
  height: 46rpx;
  background: #1f6046;
  border-radius: 4rpx 4rpx 0 0;
}

.sticker-diy {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 12rpx 22rpx rgba(44, 65, 56, 0.18);
}

.sticker-diy .sticker-part {
  display: none;
}

.diy-round {
  border-radius: 50%;
  border: 7rpx double rgba(255, 253, 247, 0.8);
}

.diy-ticket {
  height: 96rpx;
  margin-top: 14rpx;
  border-radius: 10rpx;
  clip-path: polygon(0 0, 100% 0, 100% 38%, 93% 50%, 100% 62%, 100% 100%, 0 100%, 0 62%, 7% 50%, 0 38%);
}

.diy-label {
  height: 88rpx;
  margin-top: 18rpx;
  border-radius: 8rpx 34rpx 34rpx 8rpx;
  border-left: 12rpx solid rgba(255, 253, 247, 0.58);
}

.diy-fern { color: #fffdf7; background: #2e6751; }
.diy-amber { color: #4b3825; background: #f2b86b; }
.diy-berry { color: #fffdf7; background: #a6545c; }
.diy-ink { color: #fffdf7; background: #31506a; }

.diy-sticker-text {
  position: relative;
  z-index: 2;
  max-width: 100rpx;
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
  white-space: nowrap;
}

.sticker-spark .sticker-part-b {
  top: 12rpx;
  right: 6rpx;
}

.sticker-spark .sticker-part-c {
  bottom: 8rpx;
  left: 8rpx;
}

.door-open-control {
  position: absolute;
  z-index: 1200;
  right: 18rpx;
  bottom: 22rpx;
  min-width: 286rpx;
  min-height: 102rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  margin: 0;
  padding: 12rpx 22rpx 12rpx 12rpx;
  color: #fffdf7;
  background: #1f6046;
  border-radius: 24rpx;
  line-height: 1.3;
  box-shadow: 0 14rpx 28rpx rgba(31, 96, 70, 0.2);
}

.door-handle {
  width: 20rpx;
  height: 70rpx;
  background: #f2b86b;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 4rpx rgba(255, 253, 247, 0.22);
}

.door-open-copy {
  text-align: left;
}

.door-open-title,
.door-open-note {
  display: block;
}

.door-open-title {
  font-size: 27rpx;
  font-weight: 750;
}

.door-open-note {
  margin-top: 5rpx;
  color: #d7e5dc;
  font-size: 20rpx;
}

.door-tools {
  flex: none;
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
}

.door-tool {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #244d3d;
  background: #fffdf7;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 88rpx;
  box-shadow: 0 8rpx 20rpx rgba(44, 65, 56, 0.07);
}

.content {
  flex: 1;
  min-height: 0;
}

.content.view-transition-out.left {
  animation: view-switch-out-left 160ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.content.view-transition-out.right {
  animation: view-switch-out-right 160ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.content.view-transition-in.left {
  animation: view-switch-in-left 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.content.view-transition-in.right {
  animation: view-switch-in-right 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes view-switch-out-left {
  to { transform: translate3d(-24rpx, 0, 0); opacity: 0; }
}

@keyframes view-switch-out-right {
  to { transform: translate3d(24rpx, 0, 0); opacity: 0; }
}

@keyframes view-switch-in-left {
  from { transform: translate3d(24rpx, 0, 0); opacity: 0; }
  to { transform: translate3d(0, 0, 0); opacity: 1; }
}

@keyframes view-switch-in-right {
  from { transform: translate3d(-24rpx, 0, 0); opacity: 0; }
  to { transform: translate3d(0, 0, 0); opacity: 1; }
}

.view-tabs {
  flex: none;
  display: flex;
  gap: 8rpx;
  margin: 12rpx 24rpx 0;
  padding: 8rpx;
  background: #e7e8e1;
  border-radius: 18rpx;
}

.view-tab {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  color: #667970;
  background: transparent;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.view-tab.active {
  color: #173b2d;
  background: #fffdf7;
  box-shadow: 0 6rpx 18rpx rgba(44, 65, 56, 0.08);
}

.close-door-row {
  position: fixed;
  z-index: 1200;
  right: 24rpx;
  bottom: calc(188rpx + env(safe-area-inset-bottom));
  width: 286rpx;
  display: flex;
  padding: 0;
  box-sizing: border-box;
}

.history-clear-row {
  position: fixed;
  z-index: 1200;
  right: 24rpx;
  bottom: calc(296rpx + env(safe-area-inset-bottom));
  width: 286rpx;
}

.history-clear-control {
  display: block;
  width: 286rpx;
  min-width: 0;
  max-width: 286rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #9a4d42;
  background: #fffdf7;
  border-radius: 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 66, 49, 0.12);
}

.close-door-control {
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0;
  padding: 10rpx 22rpx 10rpx 12rpx;
  color: #f7f3e9;
  background: #244d3d;
  border-radius: 24rpx;
  box-sizing: border-box;
  text-align: left;
  box-shadow: 0 10rpx 24rpx rgba(24, 66, 49, 0.14);
}

.close-door-knob {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2b86b;
  border-radius: 18rpx;
}

.close-door-knob view {
  width: 8rpx;
  height: 38rpx;
  background: #fffdf7;
  border-radius: 999rpx;
}

.close-door-copy {
  min-width: 0;
}

.close-door-title,
.close-door-note {
  display: block;
}

.close-door-title {
  font-size: 26rpx;
  font-weight: 700;
}

.close-door-note {
  margin-top: 3rpx;
  color: #d7e5dc;
  font-size: 20rpx;
}

.overview {
  margin: 16rpx 24rpx 0;
  padding: 42rpx 36rpx 34rpx;
  color: #f7f3e9;
  background: #1f6046;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(24, 66, 49, 0.18);
}

.overview-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.42;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.overview-stats {
  display: flex;
  align-items: stretch;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-divider {
  width: 1rpx;
  margin: 2rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
}

.stat-value {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.stat-value-warm {
  color: #f2b86b;
}

.stat-label {
  margin-top: 12rpx;
  color: #d7e5dc;
  font-size: 24rpx;
}

.reminder-entry {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 0;
  padding: 0 24rpx;
  color: #f7f3e9;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  line-height: 1.4;
}

.reminder-entry-copy {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.reminder-entry-title {
  font-size: 25rpx;
  font-weight: 700;
}

.reminder-entry-status {
  color: #d7e5dc;
  font-size: 23rpx;
}

.reminder-entry-action {
