.elder-home-section-title {
  display: block;
  margin: 36rpx 4rpx 18rpx;
  color: #173b2d;
  font-size: 38rpx;
  font-weight: 750;
}

.elder-task-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.elder-task-card {
  flex: 0 0 calc(50% - 9rpx);
  min-width: 0;
  min-height: 184rpx;
  margin: 0;
  padding: 30rpx 26rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  color: #173b2d;
  background: #fffdf7;
  border-radius: 22rpx;
  box-sizing: border-box;
  text-align: left;
}
.elder-task-card.add { background: #f2b86b; }
.elder-task-card.receipt { background: #dfe9e1; }
.elder-task-card.meal,
.elder-task-card.history { background: #fffdf7; }
.elder-task-title,
.elder-task-note { display: block; }
.elder-task-title { font-size: 42rpx; font-weight: 750; line-height: 1.3; }
.elder-task-note { margin-top: 12rpx; color: #52675e; font-size: 34rpx; line-height: 1.35; }
.elder-task-card.add .elder-task-note { color: #5f482f; }

.elder-secondary-title { margin-top: 38rpx; }
.elder-quick-list { overflow: hidden; background: #fffdf7; border-radius: 22rpx; }
.elder-quick-list .elder-quick-row {
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  min-height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 !important;
  padding: 20rpx 28rpx !important;
  color: #173b2d;
  background: transparent;
  box-sizing: border-box;
  text-align: left;
  font-weight: 400;
}
.elder-quick-row > view:first-child { flex: 1; min-width: 0; }
.elder-quick-title,
.elder-quick-note { display: block; }
.elder-quick-title { font-size: 42rpx; font-weight: 750; line-height: 1.3; }
.elder-quick-note { margin-top: 8rpx; color: #52675e; font-size: 34rpx; line-height: 1.35; }
.elder-quick-divider { height: 1rpx; margin: 0 28rpx; background: #e7e8e1; }

.elder-view-tabs { padding: 12rpx; }
.elder-view-tabs .view-tab { min-width: 0; min-height: 96rpx; font-size: 30rpx; line-height: 96rpx; white-space: nowrap; }
.elder-back-home-row { flex: none; padding: 0 24rpx 12rpx; }
.elder-back-home {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  color: #1f6046;
  background: #edf0eb;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.elder-mode .family-nav { font-size: 34rpx; }
.elder-mode .settings-nav-title { font-size: 38rpx; }
.elder-mode .settings-gear-image { width: 60rpx; height: 60rpx; }
.elder-mode .settings-back { font-size: 31rpx; }
.elder-mode .settings-intro { padding: 18rpx 8rpx 10rpx; }
.elder-mode .settings-intro-title { font-size: 50rpx; }
.elder-mode .settings-section { margin-top: 34rpx; }
.elder-mode .settings-section-title { margin-bottom: 16rpx; font-size: 30rpx; color: #244d3d; }
.elder-mode .settings-row,
.elder-mode .settings-link-row { min-height: 150rpx; padding: 26rpx 28rpx; }
.elder-mode .settings-content .settings-link-row { padding: 26rpx 28rpx !important; }
.elder-mode .settings-row-title { font-size: 38rpx; line-height: 1.35; }
.elder-mode .settings-row-note { margin-top: 9rpx; font-size: 30rpx; color: #244d3d; line-height: 1.45; }
.elder-mode .settings-chevron { width: 22rpx; height: 22rpx; border-width: 4rpx; }
.elder-mode .settings-danger-group { padding: 28rpx; }
.elder-mode .settings-delete { min-height: 108rpx; font-size: 34rpx; line-height: 108rpx; }
.elder-mode .family-sheet-start { padding-right: 36rpx; padding-left: 36rpx; }
.elder-mode .family-sheet-start .sheet-heading { gap: 24rpx; margin-bottom: 26rpx; }
.elder-mode .family-sheet-start .sheet-heading > view { flex: 1; min-width: 0; }
.elder-mode .family-sheet-start .sheet-title { font-size: 42rpx; line-height: 1.3; }
.elder-mode .family-sheet-start .sheet-subtitle { margin-top: 8rpx; font-size: 29rpx; line-height: 1.45; }
.elder-mode .family-sheet-start .close-button { flex: none; width: 160rpx; min-width: 160rpx; max-width: 160rpx; font-size: 29rpx; }
.elder-mode .family-sheet-start .family-intro { margin-bottom: 22rpx; padding: 24rpx 26rpx; font-size: 30rpx; line-height: 1.55; }
.elder-mode .family-sheet-start .save-button,
.elder-mode .family-sheet-start .family-secondary { width: 100%; min-height: 104rpx; margin: 16rpx 0 0; box-sizing: border-box; font-size: 34rpx; line-height: 104rpx; }
.elder-mode .family-sheet-start .family-privacy { margin-top: 20rpx; font-size: 28rpx; line-height: 1.5; text-align: left; }
.elder-mode .overview { padding: 38rpx 34rpx; }
.elder-mode .overview-title { font-size: 50rpx; }
.elder-mode .stat-value { font-size: 62rpx; }
.elder-mode .stat-label { font-size: 31rpx; }
.elder-mode .finder { padding: 28rpx 24rpx; }
.elder-mode .search-input { min-height: 104rpx; padding: 0 26rpx; font-size: 34rpx; }
.elder-mode .filter-label,
.elder-mode .filter-chip { font-size: 30rpx; }
.elder-mode .filter-chip { min-height: 88rpx; padding: 0 28rpx; line-height: 88rpx; }
.elder-mode .section-title { font-size: 40rpx; }
.elder-mode .food-item { padding: 30rpx 26rpx; }
.elder-mode .category-mark { display: none; }
.elder-mode .food-main { margin-left: 0; }
.elder-mode .food-name { font-size: 42rpx; line-height: 1.3; }
.elder-mode .expiry-tag { padding: 10rpx 18rpx; font-size: 30rpx; }
.elder-mode .food-meta { margin-top: 16rpx; color: #244d3d; font-size: 32rpx; }
.elder-mode .food-actions { gap: 12rpx; margin-top: 26rpx; }
.elder-mode .text-action {
  flex: 1;
  min-width: 0;
  min-height: 100rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 100rpx;
}
.elder-mode .text-action.edit { color: #244d3d; background: #edf0eb; }
.elder-mode .text-action.finish { background: #dfe9e1; }
.elder-mode .text-action.waste { background: #f7dcd5; }
.elder-mode .primary-button { min-height: 108rpx; font-size: 36rpx; line-height: 108rpx; }
.elder-mode .history-section { padding: 24rpx; }
.elder-mode .history-intro { padding: 38rpx 32rpx; }
.elder-mode .history-title { font-size: 48rpx; }
.elder-mode .history-item { padding: 30rpx 26rpx; }
.elder-mode .history-food-name { font-size: 38rpx; }
.elder-mode .outcome-tag { padding: 10rpx 16rpx; font-size: 29rpx; }
.elder-mode .history-meta { margin-top: 14rpx; font-size: 30rpx; }
.elder-mode .undo-button { min-width: 126rpx; min-height: 96rpx; font-size: 30rpx; line-height: 96rpx; }
.elder-mode .empty-title { font-size: 38rpx; }
.elder-mode .empty-copy { font-size: 30rpx; }
.elder-mode .receipt-title,
.elder-mode .meal-title { font-size: 46rpx; line-height: 1.3; }
.elder-mode .receipt-actions { flex-direction: column; gap: 18rpx; }
.elder-mode .receipt-scan,
.elder-mode .receipt-manual { width: 100%; min-height: 104rpx; font-size: 32rpx; line-height: 104rpx; }
.elder-mode .meal-section { padding: 30rpx 26rpx; }
.elder-mode .meal-section-title { font-size: 38rpx; line-height: 1.35; }
.elder-mode .meal-settings-summary { font-size: 30rpx; }
.elder-mode .meal-settings-action { width: 142rpx; min-width: 142rpx; height: 96rpx; min-height: 96rpx; max-height: 96rpx; font-size: 30rpx; line-height: 96rpx; }
.elder-mode .meal-section-title-row { width: 100%; justify-content: space-between; }
.elder-mode .meal-section-title-row .meal-section-title { flex: 1; white-space: normal; }
.elder-mode .meal-ai-generate { width: 172rpx; min-width: 172rpx; max-width: 172rpx; min-height: 92rpx; font-size: 29rpx; line-height: 92rpx; }
.elder-mode .meal-empty,
.elder-mode .meal-line,
.elder-mode .meal-step,
.elder-mode .health-disclaimer { font-size: 29rpx; line-height: 1.55; }
.elder-mode .meal-card-title { font-size: 38rpx; }
.elder-mode .diet-group-title { font-size: 36rpx; }
.elder-mode .diet-group-note { font-size: 28rpx; }
.elder-mode .diet-option { font-size: 30rpx; }

.motion-reduced .door-scene.opening,
.motion-reduced .inventory-surface.closing,
.motion-reduced .content.view-transition-out.left,
.motion-reduced .content.view-transition-out.right,
.motion-reduced .content.view-transition-in.left,
.motion-reduced .content.view-transition-in.right,
.motion-reduced .sheet { animation: none; }
.motion-reduced .magnet-item { transition: none; }
